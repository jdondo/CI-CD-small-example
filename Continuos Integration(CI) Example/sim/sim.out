 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 9 "y";
v0x5a0e97776aa0_0 .net/s *"_ivl_0", 8 0, L_0x5a0e9778b4c0;  1 drivers
v0x5a0e9778ae00_0 .net/s *"_ivl_2", 8 0, L_0x5a0e9778b5e0;  1 drivers
