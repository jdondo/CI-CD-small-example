v0x5a0e9778afa0_0 .net/s "b", 7 0, v0x5a0e9778b2f0_0;  1 drivers
v0x5a0e9778b080_0 .net/s "y", 8 0, L_0x5a0e9778b6d0;  alias, 1 drivers
L_0x5a0e9778b4c0 .extend/s 9, v0x5a0e9778b230_0;
L_0x5a0e9778b5e0 .extend/s 9, v0x5a0e9778b2f0_0;
L_0x5a0e9778b6d0 .arith/sum 9, L_0x5a0e9778b4c0, L_0x5a0e9778b5e0;
    .scope S_0x5a0e97763450;
T_0 ;
    %vpi_call 2 15 "$dumpfile", "adder_tb.vcd" {0 0 0};
    %vpi_call 2 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a0e97763450 {0 0 0};
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5a0e9778b230_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5a0e9778b2f0_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 15, 0, 8;
    %store/vec4 v0x5a0e9778b230_0, 0, 8;
    %pushi/vec4 10, 0, 8;
    %store/vec4 v0x5a0e9778b2f0_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 236, 0, 8;
    %store/vec4 v0x5a0e9778b230_0, 0, 8;
    %pushi/vec4 5, 0, 8;
    %store/vec4 v0x5a0e9778b2f0_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 156, 0, 8;
    %store/vec4 v0x5a0e9778b230_0, 0, 8;
    %pushi/vec4 206, 0, 8;
    %store/vec4 v0x5a0e9778b2f0_0, 0, 8;
    %delay 10000, 0;
    %vpi_call 2 27 "$display", "a=%0d b=%0d sum=%0d", v0x5a0e9778b230_0, v0x5a0e9778b2f0_0, v0x5a0e9778b3c0_0 {0 0 0};
    %vpi_call 2 28 "$finish" {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5a0e97763450;
T_1 ;
    %vpi_call 2 32 "$monitor", "%0t a=%0d b=%0d sum=%0d", $time, v0x5a0e9778b230_0, v0x5a0e9778b2f0_0, v0x5a0e9778b3c0_0 {0 0 0};
    %end;
